# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Pytest / coverage / hypothesis
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# AIWG / Claude harness (installed per-machine, not committed)
.claude/

# Editor
.idea/
.vscode/
*.swp

# Environment
.env

# Carbonyl runtime (installed locally, not committed)
~/.local/share/carbonyl/

# Rust build artifacts (applies to all crates/ sub-crates)
target/
**/target/
# Library crates: don't commit Cargo.lock
crates/*/Cargo.lock

# Generated API docs (#17) — built on demand or in CI, not committed
docs/api/

# Benchmark JSON output (#22) — produced by pytest-benchmark / CI artifact
.benchmarks/
